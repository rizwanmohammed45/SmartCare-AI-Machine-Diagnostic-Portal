# ─────────────────────────────────────────────────────────────────────────────
# SmartCare AI — Environment Variables
# Copy this file to .env and fill in your IBM Watsonx credentials.
# Without credentials, the backend runs entirely on deterministic fallback logic
# (no IBM cloud calls) and still returns correct results for all 5 brands.
# ─────────────────────────────────────────────────────────────────────────────

# IBM Watsonx AI — https://dataplatform.cloud.ibm.com
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Regional endpoint (default: us-south)
# Other options: eu-de, eu-gb, jp-tok, au-syd
WATSONX_URL=https://us-south.ml.cloud.ibm.com
